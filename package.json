{
  "name": "chatgpt-long-screenshot-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/supertest": "7.2.1",
    "archiver": "8.0.0",
    "eslint": "10.8.0",
    "playwright": "1.62.1",
    "supertest": "7.2.2",
    "tsx": "4.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
